{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "src/index.mjs",
  "name": "multipost-ai",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "assets": {
        "directory": "public",
        "binding": "ASSETS"
      }
    }
  }
}
